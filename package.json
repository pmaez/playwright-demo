{
  "name": "playwright-automation-template",
  "version": "1.0.0",
  "description": "Template Playwright end-to-end test automation framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project chromium",
    "test:all-browsers": "playwright test",
    "test:ui": "playwright test --project chromium --ui",
    "test:headed": "playwright test --project chromium --headed",
    "test:smoke": "playwright test --project chromium --grep @smoke",
    "test:functional": "playwright test --project chromium --grep @functional",
    "test:tag": "playwright test --project chromium --grep",
    "test:report": "playwright show-report",
    "runner": "node runner/execution.js",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t playwright-tests:local .",
    "docker:test": "mkdir -p docker-results && docker run --rm --ipc=host -e TEST_ENV -e BASE_URL -v \"$PWD/docker-results:/results\" playwright-tests:local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
